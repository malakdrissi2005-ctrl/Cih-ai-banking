# ============================================================
# CIH AI Banking — .env.example
# Prototype academique : toutes les valeurs sont fictives.
# Ne jamais committer un fichier .env reel avec des secrets reels.
# Copier ce fichier en .env puis remplacer les valeurs "change-me-in-production".
# ============================================================

# --- Backend / Authentification (JWT session utilisateur) ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# --- Modele de langage local (Ollama) — couche de comprehension de l'Agent 1 ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# Garde le modele charge en RAM entre deux appels (evite un rechargement
# disque mesure a ~45-53s sur une machine CPU ; defaut Ollama sans ce reglage :
# 5 minutes). Voir agents/agent1_faq/llm_router.py.
OLLAMA_KEEP_ALIVE=30m
# Delai max d'un appel de routage LLM a chaud (mesure ~6.5-7s aller-retour) ;
# volontairement strict pour ne jamais bloquer sur un chargement a froid -
# le repli deterministe reste garanti dans ce cas.
OLLAMA_ROUTER_TIMEOUT_SECONDS=10
# Interrupteur operateur : "false" desactive entierement la tentative LLM et
# ne conserve que la classification deterministe existante.
LLM_ROUTER_ENABLED=true

# --- Base vectorielle ChromaDB (RAG - FAQ publique uniquement) ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_FAQ=faq_generale

# --- General Agent (questions non bancaires, agents/general_agent/) — Google Gemini ---
# Cles API distantes (jamais commitees en clair) - le General Agent ne recoit
# jamais de donnee bancaire ni de session utilisateur, voir CLAUDE.md.
#
# Rotation automatique (agents/general_agent/gemini_key_manager.py) : quand le
# quota gratuit d'une cle est epuise (429) ou qu'une cle est invalide, le
# General Agent bascule automatiquement sur la suivante, de maniere
# transparente pour l'utilisateur. 1, 2 ou 3 cles suffisent - les variables
# absentes/vides sont ignorees. Utile car chaque projet Google Cloud a son
# propre quota gratuit journalier separe (voir gemini_key_manager.py).
GEMINI_API_KEY_1=change-me-in-production
GEMINI_API_KEY_2=change-me-in-production
GEMINI_API_KEY_3=change-me-in-production
# Compatibilite ascendante : si aucune GEMINI_API_KEY_N ci-dessus n'est
# definie, GOOGLE_API_KEY (variable historique a cle unique) est utilisee
# comme repli - jamais lue si au moins une GEMINI_API_KEY_N est presente.
GOOGLE_API_KEY=change-me-in-production
# Modele flash gratuit courant (alias officiel, toujours a jour) - voir
# agents/general_agent/gemini_client.py pour le detail du choix.
GEMINI_MODEL=gemini-flash-latest

# --- Agent 2 / Protocole A2A (service separe, port 8002) ---
AGENT2_A2A_URL=http://localhost:8002/a2a/agent2
A2A_DELEGATION_TOKEN_SECRET=change-me-in-production
A2A_DELEGATION_TOKEN_TTL_SECONDS=120
A2A_TASK_TTL_MINUTES=10
A2A_CHECKPOINTER_SQLITE_PATH=./agents/agent2_transaction/checkpoint.sqlite

# --- Serveur MCP ---
MCP_SERVER_URL=http://localhost:9000

# --- Webhook n8n (signature HMAC obligatoire) ---
N8N_TRANSFER_WEBHOOK_URL=https://n8n.internal.cih-ai.local/webhook/execute-transfer
N8N_WEBHOOK_HMAC_SECRET=change-me-in-production

# --- Systeme bancaire simule (mock-banking-api, port 8010) ---
BANKING_API_BASE_URL=http://localhost:8010

# --- Regles metier du virement (valeurs fictives de demonstration) ---
DAILY_TRANSFER_LIMIT=20000.00
MONTHLY_TRANSFER_LIMIT=50000.00
TRANSFER_CURRENCY=MAD

# --- OTP simule (MockOtpService - prototype academique uniquement) ---
DEMO_OTP_CODE=123456
OTP_EXPIRATION_SECONDS=180
OTP_MAX_ATTEMPTS=3

# --- Authentification de demonstration multi-utilisateur (session_id opaque en SQLite, PAS de JWT) ---
# Session utilisateur distincte du jeton de delegation A2A - voir CLAUDE.md §4.
# Les utilisateurs de demonstration (nombre quelconque) sont importes depuis
# data/auth/users_seed.json via scripts/seed_auth_users.py. Aucun mot de passe
# n'est ecrit en dur : DEMO_DEFAULT_PASSWORD fournit le mot de passe partage
# utilise lors de l'initialisation ; seul son hash bcrypt est stocke en base.
DEMO_DEFAULT_PASSWORD=change-me-in-production
AUTH_DB_PATH=./auth.db
SESSION_EXPIRATION_MINUTES=30

# --- Base bancaire metier (separee de auth.db, liee par id_client/id_utilisateur) ---
# Schema realiste : CLIENT, UTILISATEUR_E_BANKING, COMPTE_BANCAIRE,
# CARTE_BANCAIRE, TRANSACTION, BENEFICIAIRE, account_balance_history.
# Contient aussi les comptes d'acces en ligne (mots de passe bcrypt uniquement).
#
# Generer la base de demonstration (100 clients fictifs, deterministe) :
#     python scripts/seed_demo_database.py
# Convertir une ancienne banking.db (MVP) vers ce schema :
#     python scripts/migrate_banking_database.py
BANKING_DB_PATH=./backend/data/demo_bancaire.db

# --- Base applicative du chatbot (traces conversationnelles) ---
# PHASE 1 : le schema existe (CHATBOT_SESSION / CHATBOT_MESSAGE /
# CHATBOT_EVALUATION) mais aucune ecriture automatique n'est branchee.
# Ne doit jamais recevoir de secret (OTP, mot de passe, numero de carte).
CHATBOT_DB_PATH=./backend/data/chatbot.db
